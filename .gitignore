# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# données sources locales (fichiers clients/équipements) — jamais dans le repo
/Dossier sources divers/

# compte de service Firebase (script d'import) — jamais dans le repo,
# même si un jour placé ici par erreur plutôt qu'à son emplacement
# recommandé hors dépôt
*service-account*.json
*service_account*.json
sa-key.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
